# ── Design House local config ───────────────────────────────────────────────
# Copy this file to `.env` and fill in your Pixa credentials.
# Without a key the app runs in MOCK mode: every button works, but generated
# images are placeholder composites so you can click through the whole flow.

# Your Pixa API key. When set, PROVIDER defaults to "pixa".
PIXA_API_KEY=

# Pixa REST base URL. Confirm this against your Pixa dashboard / API tab.
# (Mirrors the generate -> poll -> download flow used by the Pixa app.)
PIXA_API_BASE=https://api.pixa.com

# Default model id used for redesigns. seedream-v5-lite is a strong, cheap
# image-editing model (16 credits/image). Other options: nano-banana-2,
# seedream-v4-5, gpt-image-2, grok-imagine-image.
PIXA_MODEL=seedream-v5-lite

# Output resolution / aspect handling
PIXA_RESOLUTION=2K
PIXA_ASPECT_RATIO=4:3

# Force a provider: "pixa" or "mock". Leave blank to auto-detect from key.
PROVIDER=

# ── Zillow listing lookup ────────────────────────────────────────────────────
# Fetch house photos by address. Zillow has no public API and blocks scraping,
# so this uses a third-party Zillow API. Without a key the lookup runs in MOCK
# mode (deterministic placeholder photos) so the whole flow is clickable.
#
# Your RapidAPI key for a Zillow listing API. When set, the lookup uses it.
ZILLOW_RAPIDAPI_KEY=

# RapidAPI host for the Zillow listing API (default: zillow-com1).
ZILLOW_RAPIDAPI_HOST=zillow-com1.p.rapidapi.com

# Force a provider: "rapidapi" or "mock". Leave blank to auto-detect from key.
ZILLOW_PROVIDER=

# Port for the local server
PORT=4178
