# ── Design House config ──────────────────────────────────────────────────────
# Copy this file to `.env` for local dev, and set the same keys in the Vercel
# project's Environment Variables for production. Without keys the app can't do
# real lookups or real image generation (there is no mock fallback).

# ── House facts (RentCast) ───────────────────────────────────────────────────
# RentCast free tier: ~50 requests/month. Sign up at https://app.rentcast.io
# to get an API key. Powers the "Fetch facts" address lookup (beds/baths/sqft).
# RENTCAST_API_KEY is preferred; PROPERTY_API_KEY also works as a fallback.
RENTCAST_API_KEY=
RENTCAST_API_HOST=api.rentcast.io

# ── Image generation (Pixa) ──────────────────────────────────────────────────
# Your Pixa API key. Powers room redesigns. Get it from your Pixa dashboard.
PIXA_API_KEY=
# Pixa REST base URL — confirm against your Pixa dashboard's API tab.
PIXA_API_BASE=https://api.pixa.com
# Default model. nano-banana is a realistic image-editing model; alternatives
# include flux-kontext-pro, gpt-image, imagen4.
PIXA_MODEL=nano-banana
PIXA_RESOLUTION=2K
PIXA_ASPECT_RATIO=4:3

# Port for local dev
PORT=4178
