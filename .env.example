# ── Design House config ──────────────────────────────────────────────────────
# Copy this file to `.env` for local dev, and set the same in the Vercel project's
# Environment Variables (Production) for the live site.

# ── House facts (RentCast) ───────────────────────────────────────────────────
# RentCast free tier: ~50 requests/month. Sign up at https://app.rentcast.io
# to get an API key. Powers the "Fetch facts" address lookup (beds/baths/sqft).
# RENTCAST_API_KEY is preferred; PROPERTY_API_KEY also works as a fallback.
RENTCAST_API_KEY=
RENTCAST_API_HOST=api.rentcast.io

# ── Image generation ─────────────────────────────────────────────────────────
# Redesigns are generated keyless via Pollinations (Flux), called directly from
# the browser — no key or config required. (To switch to a paid provider later,
# add a server adapter + its key here.)

# Port for local dev
PORT=4178
